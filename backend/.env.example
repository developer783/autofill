# Server Configuration
PORT=8000
SECRET_KEY=ats_autofill_super_secret_jwt_key_change_in_prod
CORS_ORIGINS=http://localhost:5173,https://smart-autofill.onrender.com

# Database Connection (SQLite local dev default, Postgres on Render)
# Example Postgres: postgresql://user:password@ep-xyz.render.com/dbname
DATABASE_URL=sqlite:///./autofill.db

# Swappable File Storage Configuration ('local' or 's3')
STORAGE_PROVIDER=local
STORAGE_BUCKET=smart-autofill-files
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
